<?xml version="1.0" encoding="UTF-8"?>
<shipping xmlns="http://www.demandware.com/xml/impex/shipping/2007-03-31">
    <shipping-method method-id="001" default="true">
        <display-name xml:lang="x-default">Despacho a domicilio</display-name>
        <description xml:lang="x-default">Llega en 30 a 45 minutos</description>
        <online-flag>true</online-flag>
        <tax-class-id>standard</tax-class-id>
        <price-table>
            <amount order-value="0">1990</amount>
        </price-table>
        <custom-attributes>
            <custom-attribute attribute-id="estimatedArrivalTime" xml:lang="x-default">30-45 min</custom-attribute>
        </custom-attributes>
    </shipping-method>

    <shipping-method method-id="ZZ_PRUEBA_DELIVERY_TRAMOS" default="false">
        <display-name xml:lang="x-default">PRUEBA Delivery por tramos</display-name>
        <online-flag>false</online-flag>
        <tax-class-id>standard</tax-class-id>
        <price-table>
            <amount order-value="0">2000</amount>
            <amount order-value="10000">1000</amount>
            <amount order-value="15000">0</amount>
        </price-table>
        <customer-groups>
            <customer-group>ZZ_PRUEBA_GRUPO_TIENDAS_PILOTO</customer-group>
        </customer-groups>
    </shipping-method>

    <shipping-method method-id="005" default="false">
        <display-name xml:lang="x-default">Retiro en tienda</display-name>
        <description xml:lang="x-default">Listo en 15 minutos</description>
        <online-flag>true</online-flag>
        <tax-class-id>standard</tax-class-id>
        <price-table>
            <amount order-value="0">0</amount>
        </price-table>
        <custom-attributes>
            <custom-attribute attribute-id="estimatedArrivalTime" xml:lang="x-default">15 min</custom-attribute>
            <custom-attribute attribute-id="storePickupEnabled">true</custom-attribute>
        </custom-attributes>
    </shipping-method>

</shipping>
