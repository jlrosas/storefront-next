        <type>component.Content.pjHeroFood</type>
        <data xml:lang="x-default">{
  "productId": "cb-pizza-del-mes",
  "variant": "season",
  "ctaLabel": "Lo quiero",
  "animate": true,
  "profile": "valentina"
}</data>
        <online-flag>true</online-flag>
        <online-flag site-id="PapaJohnsCL">true</online-flag>
