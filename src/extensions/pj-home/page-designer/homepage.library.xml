<?xml version="1.0" encoding="UTF-8"?>
<!--
  Propuesta de HOM para DAT: página «homepage» de Page Designer con los tres perfiles en la región «home».
  Cada componente trae el atributo «profile» (todos|valentina|diego|sofia), que ya filtra por perfil en el storefront
  (también con ?perfil=). Además, en Business Manager se asigna a cada componente su grupo de clientes
  (pj-reactivacion, pj-anuncio-super-duo, pj-frecuente) con el programa de visibilidad de Page Designer (HOM-04 criterio 2).
  Requiere desplegar antes el cartucho con los tipos Content.pj* (pnpm cartridge:generate + deploy).
-->
<library xmlns="http://www.demandware.com/xml/impex/library/2006-10-31" library-id="PapaJohnsCLLibrary">
